# syntax=docker/dockerfile:1
FROM node:24.19.0-slim AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable
RUN corepack prepare pnpm@10.22.0 --activate

FROM base AS build
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ git pkg-config libsecret-1-dev && rm -rf /var/lib/apt/lists/*

WORKDIR /usr/src/app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json ./apps/api/package.json
COPY apps/dokploy/package.json ./apps/dokploy/package.json
COPY apps/schedules/package.json ./apps/schedules/package.json
COPY packages/server/package.json ./packages/server/package.json

# Install one consistent application/server graph. Mixing production-only and
# development installs can create duplicate peer instances in the virtual store.
ENV NODE_OPTIONS=--max-old-space-size=4096
ENV CI=true
ENV PNPM_DISABLE_SELF_UPDATE_CHECK=true
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile --prefer-offline --child-concurrency=1 --network-concurrency=1 --reporter=silent

COPY . /usr/src/app

# Deploy only the dokploy app
# ARG NEXT_PUBLIC_UMAMI_HOST
# ENV NEXT_PUBLIC_UMAMI_HOST=$NEXT_PUBLIC_UMAMI_HOST

# ARG NEXT_PUBLIC_UMAMI_WEBSITE_ID
# ENV NEXT_PUBLIC_UMAMI_WEBSITE_ID=$NEXT_PUBLIC_UMAMI_WEBSITE_ID

ENV NODE_ENV=production
ENV DOKPLOY_BUILD_TARGET=managed
ENV PLATFORM_MODE=managed
ENV MANAGED_BUILD_ARTIFACT_CANARY=vlyv-managed-build-artifact-canary
RUN pnpm --filter=@dokploy/server build
RUN pnpm --filter=./apps/dokploy run build

RUN pnpm --filter=./apps/dokploy --prod deploy --legacy /prod/dokploy

RUN cp -R /usr/src/app/apps/dokploy/.next /prod/dokploy/.next
RUN cp -R /usr/src/app/apps/dokploy/dist /prod/dokploy/dist

FROM base AS dokploy
WORKDIR /app

# Set production
ENV NODE_ENV=production
ENV PLATFORM_MODE=managed
ENV APP_NAME=vlyv
ENV PLATFORM_APPS_DOMAIN=apps.vlyv.dev

RUN apt-get update && apt-get install -y curl unzip apache2-utils && rm -rf /var/lib/apt/lists/*

# Copy only the necessary files
COPY --from=build /prod/dokploy/.next ./.next
COPY --from=build /prod/dokploy/dist ./dist
COPY --from=build /prod/dokploy/next.config.mjs ./next.config.mjs
COPY --from=build /prod/dokploy/public ./public
COPY --from=build /prod/dokploy/package.json ./package.json
COPY --from=build /prod/dokploy/drizzle ./drizzle
COPY --from=build /prod/dokploy/components.json ./components.json
COPY --from=build /prod/dokploy/node_modules ./node_modules

EXPOSE 3000
CMD ["sh", "-c", "node -r dotenv/config dist/migration.mjs && exec node -r dotenv/config dist/server.mjs"]
