# vlyv managed production environment
# Copy to your deployment secret store, replace every <...> placeholder, and never commit real secrets.

# -----------------------------------------------------------------------------
# Runtime and public URLs
# -----------------------------------------------------------------------------
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
PLATFORM_MODE=managed
DOKPLOY_BUILD_TARGET=managed
APP_NAME=vlyv
PLATFORM_URL=https://vlyv.dev
BETTER_AUTH_URL=https://vlyv.dev
SITE_URL=https://vlyv.dev
PLATFORM_APPS_DOMAIN=apps.vlyv.dev
PLATFORM_ADMIN_EMAILS=<platform-admin@vlyv.dev>

# -----------------------------------------------------------------------------
# PostgreSQL control-plane database, Better Auth, and infrastructure encryption
# Generate BETTER_AUTH_SECRET with at least 32 cryptographically random bytes.
# Keep both secrets stable and back them up securely.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://<user>:<password>@<postgres-host>:5432/<database>?sslmode=require
BETTER_AUTH_SECRET=<64-character-random-secret>
ENCRYPTION_KEY=<64-character-random-secret-distinct-from-better-auth>
# Optional alternative: mount a secret file and set ENCRYPTION_KEY_FILE instead.
ENCRYPTION_KEY_FILE=
GITHUB_CLIENT_ID=<github-oauth-client-id>
GITHUB_CLIENT_SECRET=<github-oauth-client-secret>
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>

# -----------------------------------------------------------------------------
# Transactional email through Resend SMTP
# Use a verified vlyv.dev sender. The SMTP password is a Resend API key.
# -----------------------------------------------------------------------------
SMTP_FROM_ADDRESS=vlyv <notifications@vlyv.dev>
SMTP_SERVER=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=<resend-api-key>

# -----------------------------------------------------------------------------
# Polar billing (no browser key is required)
# Create products in Polar, copy their IDs, and configure this webhook endpoint:
# https://vlyv.dev/api/polar/webhook
# Required webhook events: customer.state_changed, customer.deleted,
# subscription.*, and order.paid.
# -----------------------------------------------------------------------------
POLAR_ENVIRONMENT=production
POLAR_ACCESS_TOKEN=<new-polar-organization-access-token>
POLAR_WEBHOOK_SECRET=<polar-webhook-secret>
POLAR_ORGANIZATION_ID=<polar-organization-id>
POLAR_HOBBY_MONTHLY_PRODUCT_ID=<polar-product-id>
POLAR_HOBBY_ANNUAL_PRODUCT_ID=<polar-product-id>
POLAR_STARTUP_MONTHLY_PRODUCT_ID=<polar-product-id>
POLAR_STARTUP_ANNUAL_PRODUCT_ID=<polar-product-id>
# Optional only while migrating a legacy vlyv plan.
POLAR_LEGACY_MONTHLY_PRODUCT_ID=
POLAR_LEGACY_ANNUAL_PRODUCT_ID=
# Create one Polar Sum meter per event name and aggregate the `quantity` property.
POLAR_USAGE_EVENT_PREFIX=vlyv
POLAR_USAGE_MAX_EVENT_AGE_HOURS=840
# Set once to the exact canonical UTC instant Polar becomes the usage billing source.
POLAR_USAGE_CUTOVER_AT=<YYYY-MM-DDTHH:mm:ss.sssZ>

# -----------------------------------------------------------------------------
# Temporal durable orchestration
# Use Temporal Cloud or a highly available Temporal deployment.
# -----------------------------------------------------------------------------
TEMPORAL_ENABLED=true
TEMPORAL_ADDRESS=<namespace>.<account>.tmprl.cloud:7233
TEMPORAL_NAMESPACE=<temporal-namespace>
TEMPORAL_TASK_QUEUE=vlyv-deployments
TEMPORAL_TLS=true
TEMPORAL_API_KEY=<temporal-api-key>
TEMPORAL_MAX_CONCURRENT_ACTIVITIES=20
TEMPORAL_CANCELLATION_WAIT_MS=120000

# -----------------------------------------------------------------------------
# Managed PostgreSQL for customers (Neon only)
# PostgreSQL is the only managed database product exposed by the control plane.
# -----------------------------------------------------------------------------
NEON_PROVIDER_NAME=neon
NEON_API_KEY=<neon-api-key>
NEON_ORGANIZATION_ID=<neon-organization-id>
NEON_API_URL=https://console.neon.tech/api/v2
# Map vlyv region slugs to Neon region IDs.
NEON_REGION_MAPPINGS={"layerrail-primary":"<neon-region-id>"}

# -----------------------------------------------------------------------------
# Environment-driven managed platform bootstrap
# Startup idempotently reconciles Layerrail Kubernetes, Cloudflare, R2,
# AWS archive storage, and Grafana Cloud. Activation fails closed if a required
# capability or remote credential cannot be verified.
# -----------------------------------------------------------------------------
PLATFORM_BOOTSTRAP_ENABLED=true
PLATFORM_BOOTSTRAP_ACTIVATE=true

# Layerrail managed Kubernetes (standard kubeconfig)
PLATFORM_REGION_SLUG=layerrail-primary
PLATFORM_REGION_NAME=Layerrail Primary
PLATFORM_REGION_PROVIDER=layerrail
PLATFORM_REGION_LOCATION=<city-or-region>
PLATFORM_CLUSTER_SLUG=layerrail-primary
PLATFORM_CLUSTER_NAME=Layerrail Primary
PLATFORM_CLUSTER_API_ENDPOINT=https://<kubernetes-api-host>:6443
# Base64-encode the complete kubeconfig as one line before placing it here.
PLATFORM_KUBERNETES_KUBECONFIG_BASE64=<base64-kubeconfig>
PLATFORM_KUBERNETES_IN_CLUSTER=false
PLATFORM_NODE_ARCHITECTURE=amd64

# Cluster capabilities that must already be installed and healthy.
PLATFORM_KUBERNETES_SECRETS_ENCRYPTION_ENABLED=true
PLATFORM_KUBERNETES_NETWORK_POLICY_ENABLED=true
PLATFORM_KUBERNETES_METRICS_SERVER_ENABLED=true
PLATFORM_KUBERNETES_GATEWAY_API_ENABLED=true
PLATFORM_KUBERNETES_CERT_MANAGER_ENABLED=true
PLATFORM_KUBERNETES_EXTERNAL_DNS_ENABLED=true
PLATFORM_KUBERNETES_MULTI_ZONE_ENABLED=true
PLATFORM_KUBERNETES_READ_ONLY_ROOT_FILESYSTEM=true
PLATFORM_RUNTIME_CLASS_NAME=<sandbox-runtime-class>
PLATFORM_BUILD_RUNTIME_CLASS_NAME=<sandbox-runtime-class>
PLATFORM_GATEWAY_NAMESPACE=vlyv-system
PLATFORM_GATEWAY_NAME=vlyv-gateway
PLATFORM_GATEWAY_CLASS_NAME=<gateway-class-name>
PLATFORM_GATEWAY_MODE=shared
PLATFORM_GATEWAY_SECTION_NAME=https
PLATFORM_GATEWAY_POD_SELECTOR_JSON={"app.kubernetes.io/name":"<gateway-pod-label>"}
PLATFORM_CERT_ISSUER_NAME=letsencrypt-prod
PLATFORM_EXTERNAL_DNS_NAMESPACE=external-dns
PLATFORM_EXTERNAL_DNS_DEPLOYMENT_NAME=external-dns
PLATFORM_EXTERNAL_DNS_TARGET=cloudflare
PLATFORM_EXTERNAL_DNS_TTL=60
PLATFORM_METRICS_SERVER_NAMESPACE=kube-system
PLATFORM_METRICS_SERVER_DEPLOYMENT_NAME=metrics-server
PLATFORM_ALLOWED_EGRESS_CIDRS_JSON=[]

# Node pools and scheduling. Labels must match real Layerrail nodes.
PLATFORM_RUNTIME_NODE_POOL_NAME=runtime
PLATFORM_RUNTIME_NODE_LABELS_JSON={"vlyv.dev/pool":"runtime"}
PLATFORM_RUNTIME_NODE_TAINTS_JSON=[]
PLATFORM_RUNTIME_MIN_NODES=1
PLATFORM_RUNTIME_MAX_NODES=20
PLATFORM_BUILD_NODE_POOL_NAME=build
PLATFORM_BUILD_NODE_LABELS_JSON={"vlyv.dev/pool":"build"}
PLATFORM_BUILD_NODE_TAINTS_JSON=[{"key":"vlyv.dev/build","value":"true","effect":"NoSchedule"}]
PLATFORM_BUILD_MIN_NODES=1
PLATFORM_BUILD_MAX_NODES=20
PLATFORM_SYSTEM_NODE_POOL_NAME=system
PLATFORM_SYSTEM_NODE_LABELS_JSON={"vlyv.dev/pool":"system"}
PLATFORM_SYSTEM_NODE_TAINTS_JSON=[]
PLATFORM_SYSTEM_MIN_NODES=1
PLATFORM_SYSTEM_MAX_NODES=5
PLATFORM_RUNTIME_TARGET_NAME=primary
PLATFORM_RUNTIME_MAX_PLACEMENTS=10000
PLATFORM_RUNTIME_TARGET_WEIGHT=100

# OCI build and runtime registry
PLATFORM_BUILD_POOL_NAME=primary
PLATFORM_MAX_CONCURRENT_BUILDS=20
PLATFORM_BUILDER_IMAGE=<registry/image@sha256:64-hex-digest>
PLATFORM_REGISTRY_HOST=<registry-host-without-scheme>
PLATFORM_REGISTRY_REPOSITORY_PREFIX=vlyv/builds
PLATFORM_REGISTRY_AUTH_MODE=basic
PLATFORM_REGISTRY_USERNAME=<registry-username>
PLATFORM_REGISTRY_PASSWORD=<registry-password>
PLATFORM_RUNTIME_REGISTRY_SECRET_NAME=vlyv-registry
PLATFORM_ROOTLESS_BUILDER_VALIDATED=true
# For workload identity, set PLATFORM_REGISTRY_AUTH_MODE=workload_identity,
# clear username/password, and attest both values below.
PLATFORM_REGISTRY_CREDENTIAL_HELPER_CONFIGURED=false
PLATFORM_RUNTIME_IMAGE_PULL_IDENTITY_CONFIGURED=false

# Supply-chain verification and immutable helper images
PLATFORM_SUPPLY_CHAIN_VERIFIER_IMAGE=<registry/verifier@sha256:64-hex-digest>
PLATFORM_SUPPLY_CHAIN_OUTPUT_PUBLISHER_IMAGE=<registry/publisher@sha256:64-hex-digest>
PLATFORM_SUPPLY_CHAIN_SIGNING_KEY_REF=<awskms|gcpkms|azurekms|hashivault>://<kms-key-reference>
PLATFORM_SUPPLY_CHAIN_ARTIFACT_STORAGE_CLASS=<layerrail-storage-class>
PLATFORM_SUPPLY_CHAIN_MAX_CRITICAL=0
PLATFORM_SUPPLY_CHAIN_MAX_HIGH=0
PLATFORM_SUPPLY_CHAIN_IGNORE_UNFIXED=false
PLATFORM_SUPPLY_CHAIN_SERVICE_ACCOUNT_ANNOTATIONS_JSON={}
PLATFORM_SUPPLY_CHAIN_POD_LABELS_JSON={}
PLATFORM_SUPPLY_CHAIN_POD_ANNOTATIONS_JSON={}
PLATFORM_OUTPUT_PUBLISHER_SERVICE_ACCOUNT_ANNOTATIONS_JSON={}
PLATFORM_OUTPUT_PUBLISHER_POD_LABELS_JSON={}
PLATFORM_OUTPUT_PUBLISHER_POD_ANNOTATIONS_JSON={}

# Digest-pinned cluster agents
PLATFORM_OBSERVABILITY_COLLECTOR_IMAGE=<otel-collector-image@sha256:64-hex-digest>
PLATFORM_OBSERVABILITY_NAMESPACE=vlyv-observability
PLATFORM_MANAGED_DATA_BACKUP_IMAGE=<backup-worker-image@sha256:64-hex-digest>
PLATFORM_MANAGED_DATA_BACKUP_NAMESPACE=vlyv-backups

# -----------------------------------------------------------------------------
# Cloudflare edge and DNS
# The API token needs only the scoped zone/account permissions used by vlyv.
# Generate CLOUDFLARE_ORIGIN_TOKEN as a high-entropy secret shared with origin.
# -----------------------------------------------------------------------------
CLOUDFLARE_EDGE_PROVIDER_NAME=cloudflare
CLOUDFLARE_ACCOUNT_ID=<cloudflare-account-id>
CLOUDFLARE_ZONE_ID=<cloudflare-zone-id>
CLOUDFLARE_ZONE_NAME=vlyv.dev
CLOUDFLARE_API_TOKEN=<scoped-cloudflare-api-token>
CLOUDFLARE_ORIGIN_HOSTNAME=origin.vlyv.dev
CLOUDFLARE_ORIGIN_TOKEN=<64-character-random-origin-token>
CLOUDFLARE_MANAGED_DOMAIN=apps.vlyv.dev
CLOUDFLARE_GEO_ROUTING_ENABLED=false
CLOUDFLARE_CACHE_TTL_SECONDS=3600
CLOUDFLARE_BROWSER_TTL_SECONDS=300
CLOUDFLARE_LOAD_BALANCER_POOL_IDS_JSON=[]
CLOUDFLARE_LOAD_BALANCER_FALLBACK_POOL_ID=

# Cloudflare R2 static assets (R2 encrypts objects at rest automatically).
# Connect R2_PUBLIC_BASE_URL as a production custom domain in Cloudflare.
R2_STORAGE_NAME=cloudflare-r2
R2_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com
R2_REGION=auto
R2_BUCKET=<r2-bucket-name>
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_PUBLIC_BASE_URL=https://assets.vlyv.dev
R2_PREFIX=vlyv-assets
R2_FORCE_PATH_STYLE=false
R2_CACHE_CONTROL=public, max-age=31536000, immutable

# -----------------------------------------------------------------------------
# Independent managed PostgreSQL archives
# Cloudflare R2 does not implement AWS SSE-KMS request headers. Keep this
# separate private, versioned AWS S3 bucket with default aws:kms encryption and
# all four S3 Block Public Access controls enabled.
# -----------------------------------------------------------------------------
AWS_ARCHIVE_STORAGE_NAME=managed-data-archives
AWS_ARCHIVE_REGION=<aws-region>
AWS_ARCHIVE_ENDPOINT=https://s3.<aws-region>.amazonaws.com
AWS_ARCHIVE_BUCKET=<private-versioned-s3-bucket>
AWS_ARCHIVE_ACCESS_KEY_ID=<archive-writer-access-key-id>
AWS_ARCHIVE_SECRET_ACCESS_KEY=<archive-writer-secret-access-key>
AWS_ARCHIVE_KMS_KEY_ARN=arn:aws:kms:<region>:<12-digit-account-id>:key/<key-id>
AWS_ARCHIVE_PREFIX=vlyv-managed-data-archives

# -----------------------------------------------------------------------------
# Grafana Cloud observability
# Copy the exact endpoint and headers from the stack's OpenTelemetry tile.
# The Authorization value must be percent-encoded (`Basic%20...`).
# The same settings export control-plane telemetry and bootstrap the in-cluster
# OTLP collector for tenant workloads.
# -----------------------------------------------------------------------------
OTEL_ENABLED=true
OTEL_SERVICE_NAME=vlyv-control-plane
OTEL_SERVICE_VERSION=<release-version>
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<grafana-region>.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64-instance-id-colon-token>
OTEL_PROMETHEUS_ENABLED=false
OTEL_PROMETHEUS_HOST=127.0.0.1
OTEL_PROMETHEUS_PORT=9464
OTEL_PROMETHEUS_ENDPOINT=/metrics
OTEL_METRIC_EXPORT_INTERVAL_MS=30000
GRAFANA_OTLP_BACKEND_NAME=grafana-cloud-otlp
# Optional tenant query endpoints. Copy these from the Grafana Cloud stack.
GRAFANA_CLOUD_BASIC_AUTH=<base64-instance-id-colon-token>
GRAFANA_PROMETHEUS_URL=
GRAFANA_PROMETHEUS_HEALTH_ENDPOINT=
GRAFANA_LOKI_URL=
GRAFANA_LOKI_HEALTH_ENDPOINT=
GRAFANA_TEMPO_URL=
GRAFANA_TEMPO_HEALTH_ENDPOINT=

# -----------------------------------------------------------------------------
# Managed runtime limits
# -----------------------------------------------------------------------------
PLATFORM_DEFAULT_MEMORY_LIMIT_BYTES=536870912
PLATFORM_DEFAULT_MEMORY_RESERVATION_BYTES=134217728
PLATFORM_DEFAULT_CPU_LIMIT_NANO=1000000000
PLATFORM_DEFAULT_CPU_RESERVATION_NANO=250000000
PLATFORM_MAX_MEMORY_LIMIT_BYTES=2147483648
PLATFORM_MAX_CPU_LIMIT_NANO=2000000000
PLATFORM_MAX_FILE_MOUNT_BYTES=1048576
PLATFORM_KUBERNETES_MAX_REPLICAS=10
PLATFORM_KUBERNETES_TARGET_CPU_PERCENT=70
PLATFORM_RUNTIME_EPHEMERAL_STORAGE_LIMIT_BYTES=2147483648
PLATFORM_RUNTIME_EPHEMERAL_STORAGE_REQUEST_BYTES=268435456
PLATFORM_BUILD_TIMEOUT_MS=900000
PLATFORM_SUPPLY_CHAIN_TIMEOUT_MS=600000
PLATFORM_BUILD_MEMORY_LIMIT_BYTES=4294967296
PLATFORM_BUILD_MEMORY_REQUEST_BYTES=536870912
PLATFORM_BUILD_CPU_LIMIT_NANO=4000000000
PLATFORM_BUILD_CPU_REQUEST_NANO=500000000
PLATFORM_BUILD_EPHEMERAL_STORAGE_LIMIT_BYTES=21474836480
PLATFORM_BUILD_EPHEMERAL_STORAGE_REQUEST_BYTES=2147483648
PLATFORM_HTTP_HEALTH_CHECK=true
PREVIEW_DEPLOYMENT_TTL_HOURS=168
RELEASE_STALE_TIMEOUT_MS=14400000
